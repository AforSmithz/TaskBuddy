# pnpm's default `node-linker=isolated` builds node_modules out of symlinks into
# a virtual store: `node_modules/next` points at
# `node_modules/.pnpm/next@<ver>/node_modules/next`, and next's own transitive
# deps - @swc/helpers, styled-jsx, @next/env, sharp - sit BESIDE it in that
# directory rather than at the top level.
#
# `output: "standalone"` copies that shape verbatim, symlinks and all. When the
# CDK asset for the web Lambda is staged the symlinks get materialised, so
# `node_modules/next` lands as a real top-level directory - and loses the
# siblings it resolved through. The deployed function then dies during init with
#
#   Error: Cannot find module '@swc/helpers/_/_interop_require_default'
#   requireStack: [ /var/task/node_modules/next/dist/shared/lib/constants.js ]
#
# which reads like a missing dependency and is really a flattened symlink tree.
# @swc/helpers is merely the first require to hit it; the other three are behind.
#
# `hoisted` makes pnpm write a flat npm-style node_modules of real directories,
# so the traced bundle is already the shape Node's resolver expects and nothing
# depends on symlinks surviving the trip into a zip.
#
# Cost: a larger node_modules locally and the loss of pnpm's strictness about
# undeclared dependencies. Worth it - the alternative is a deployment whose
# correctness rests on symlink handling in a pipeline that has already been
# observed changing it.
node-linker=hoisted
